{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Real ContextPlanner A/B output contract",
  "type": "object", "additionalProperties": false, "required": ["A", "B"],
  "properties": {
    "A": {"$ref": "#/$defs/packet"},
    "B": {"allOf": [
      {"$ref": "#/$defs/packet"},
      {"type": "object", "required": ["zoning"], "properties": {"zoning": {"$ref": "#/$defs/zoning"}}}
    ]}
  },
  "$defs": {
    "packet": {
      "type": "object",
      "required": ["packet_path", "packet_hash", "packet_bytes", "source_item_count", "source_bytes"],
      "properties": {
        "packet_path": {"type": "string", "minLength": 1},
        "packet_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "packet_bytes": {"type": "integer", "minimum": 0},
        "source_item_count": {"type": "integer", "minimum": 0},
        "source_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "zoning": {
      "type": "object", "additionalProperties": false,
      "required": ["zone_id", "artifact_paths", "snapshot_id", "analysis_digest"],
      "properties": {
        "zone_id": {"type": "string", "minLength": 1},
        "artifact_paths": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "snapshot_id": {"type": "string", "minLength": 1},
        "analysis_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
